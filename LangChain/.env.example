OPENAI_API_KEY=你的API KEY
OPENAI_BASE_URL=实际API地址
OPENAI_MODEL=gpt-5.5
OPENAI_TEMPERATURE=0.2

DEEPSEEK_API_KEY=你的API KEY
DEEPSEEK_BASE_URL=实际API地址
DEEPSEEK_MODEL=deepseek-v4-flash

EMBEDDING_MODEL_PATH=本地Embedding模型地址
EMBEDDING_BATCH_SIZE=8
EMBEDDING_NORMALIZE=true
EMBEDDING_SHOW_PROGRESS=false

MEMORY_DIR=data/memories
CHAT_DIR=data/chats
MEMORY_SEARCH_LIMIT=3
MEMORY_BACKEND=agentic
MEMORY_NAMESPACE=default
MEMORY_CONTEXT_CHARS=3200
MEMORY_TTL_DAYS=30
MEMORY_CURATOR_ENABLED=true
MEMORY_CURATION_MODE=auto
MEMORY_INCLUDE_TASK_LOCAL=false
MEMORY_RETRIEVAL_STRATEGY=hybrid
# 更换 Embedding 权重或编码策略后提升版本，避免错误复用旧向量。
EMBEDDING_CACHE_VERSION=v1

WEB_SEARCH_ENABLED=true
SEARXNG_BASE_URL=http://localhost:8082
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=20
WEB_SEARCH_LANGUAGE=

# MedQA 独立入口优先读取以下配置；留空则使用 DEEPSEEK_*。
# 校内 OpenAI 兼容服务可配置 BASE_URL、模型名和服务要求的 key。
MEDQA_API_KEY=
MEDQA_BASE_URL=
MEDQA_MODEL=
